{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "ask",
  "subagent_depth": 1,
  "share": "disabled",
  "snapshot": true,
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "instructions": [
    "instructions/communication.md",
    "instructions/methodology.md",
    "instructions/engineering-principles.md",
    "instructions/security-policy.md",
    "instructions/git-policy.md"
  ],
  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.env.example": "allow",
      "brain/private/**": "ask"
    },
    "edit": "ask",
    "bash": "ask",
    "websearch": "allow",
    "webfetch": "allow",
    "skill": "allow",
    "lsp": "allow",
    "external_directory": "ask",
    "doom_loop": "ask"
  },
  "agent": {
    "build": {
      "disable": true,
      "options": {},
      "permission": {}
    },
    "general": {
      "disable": true,
      "options": {},
      "permission": {}
    },
    "explore": {
      "disable": true,
      "options": {},
      "permission": {}
    },
    "scout": {
      "disable": true,
      "options": {},
      "permission": {}
    }
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      ".next/**",
      "coverage/**",
      ".opencode/.workflow/**",
      "brain/.obsidian/**",
      "brain/assets/**",
      "brain/private/**",
      "brain/memory/candidates/**",
      "brain/research/sources/**"
    ]
  },
  "subagent_model": "openai/gpt-5.6-luna-fast"
}
